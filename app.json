{
  "expo": {
    "name": "Pro Football RTGA",
    "slug": "pro-football-random-team-g-and-a",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/official-PF-RTGA-icon.png",
    "scheme": "profootballrandomteamgeneratorandanalysis",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sathvik-malla.pro-football-random-team-generator-and-analysis",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#004BA1",
        "foregroundImage": "./assets/images/official-PF-RTGA-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sathvikmalla.profootballrandomteamgeneratorandanalysis"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "./plugins/withRNFirebaseDisableSPM.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Official-Pro-Football-RTGA-Splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "IconRed",
            "ios": "./assets/images/icon-red.png"
          },
          {
            "name": "IconGreen",
            "ios": "./assets/images/icon-green.png"
          },
          {
            "name": "IconAmber",
            "ios": "./assets/images/icon-amber.png"
          },
          {
            "name": "IconOrange",
            "ios": "./assets/images/icon-orange.png"
          },
          {
            "name": "IconPink",
            "ios": "./assets/images/icon-pink.png"
          },
          {
            "name": "IconCyan",
            "ios": "./assets/images/icon-cyan.png"
          },
          {
            "name": "IconNavy",
            "ios": "./assets/images/icon-navy.png"
          },
          {
            "name": "IconLime",
            "ios": "./assets/images/icon-lime.png"
          },
          {
            "name": "IconTeal",
            "ios": "./assets/images/icon-teal.png"
          },
          {
            "name": "IconMaroon",
            "ios": "./assets/images/icon-maroon.png"
          }
        ]
      ],
      "expo-web-browser",
      "expo-font",
      "@react-native-firebase/app",
      "@react-native-firebase/analytics",
      "@react-native-firebase/app-check"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "91118d13-ead9-4232-b1ee-2365b43e9570"
      }
    },
    "owner": "sathvik_malla"
  }
}
